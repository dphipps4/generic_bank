// Memory's own database (the data box). Only the Memory service opens it, and it writes in plain
// SQL, so this schema generates no client: it is the tables and their migrations.

datasource db {
  provider = "postgresql"
  url      = env("MEMORY_DATABASE_URL")
}

/// Who wrote an entry: each writer holds a token for one role.
enum Role {
  factory
  curator
}

enum RunKind {
  task
  factory
}

/// tenant: one bank; vendor: every bank on the same product; pattern: everywhere.
enum Scope {
  tenant
  vendor
  pattern
}

enum LessonState {
  proposed
  confirmed
  disputed
  retired
}

enum Confidence {
  low
  medium
  high
}

/// An episode: one run, as the system settled it. The id is the run's own id.
model Run {
  id           String     @id
  kind         RunKind
  bank         String
  vendor       String?
  task         String?
  driver       String?
  outcome      String
  startedAt    DateTime   @db.Timestamptz(3)
  endedAt      DateTime?  @db.Timestamptz(3)
  model        String?
  /// The prompt versions the run used, by prompt id.
  prompts      Json?
  evidenceHash String?
  recordedAt   DateTime   @default(now()) @db.Timestamptz(3)
  reliances    Reliance[]

  @@index([bank, startedAt])
}

/// A lesson is its versions; `current` is the version served.
model Lesson {
  id        String          @id
  current   Int             @default(0)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  versions  LessonVersion[]
  reliances Reliance[]
}

model LessonVersion {
  lessonId       String
  version        Int
  text           String
  /// Why the advice holds, and the words that tell it applies.
  why            String?
  signals        String[]
  area           String
  scenario       String?
  scope          Scope
  bank           String?
  vendor         String?
  state          LessonState
  /// The banks where the lesson was retired while it holds elsewhere.
  retiredAtBanks String[]
  confidence     Confidence
  /// Seen on the cited frames, or a guess.
  seen           Boolean
  /// What the lesson rests on, one citation per run: [{ run, frames, hash, seen }].
  evidence       Json
  reason         String?
  role           Role
  runId          String?
  model          String?
  prompts        Json?
  evidenceHash   String?
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  lesson         Lesson                      @relation(fields: [lessonId], references: [id])

  @@id([lessonId, version])
}

/// A served lesson a run relied on, and its current version when the run said so.
model Reliance {
  runId    String
  lessonId String
  version  Int
  at       DateTime @default(now()) @db.Timestamptz(3)
  run      Run      @relation(fields: [runId], references: [id])
  lesson   Lesson   @relation(fields: [lessonId], references: [id])

  @@id([runId, lessonId])
  @@index([lessonId])
}
