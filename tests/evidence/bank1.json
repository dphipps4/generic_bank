{
  "happy": {
    "steps": [
      {
        "open": "./"
      },
      {
        "type": "Operator ID",
        "value": "$operator"
      },
      {
        "type": "Password",
        "value": "$password"
      },
      {
        "press": "Sign In"
      },
      {
        "press": "Send code"
      },
      {
        "type": "Code",
        "value": "$code"
      },
      {
        "press": "Verify"
      },
      {
        "press": "Member Search"
      },
      {
        "type": "Member number",
        "value": "$member.demo"
      },
      {
        "press": "Search"
      },
      {
        "press": "Open"
      }
    ]
  },
