# ---------------------------------------------------------------------------
# Generic Bank
# ---------------------------------------------------------------------------

# Secrets. Plain .env files never leave the machine (see the .env rules above).
# SOPS-encrypted files are committed: infra/secrets/*.sops.yaml, *.sops.env
!*.sops.yaml
!*.sops.env
# age private keys (generated by the first `just up`; never committed)
*.agekey
infra/secrets/keys.txt
.sops-age/

# Local runtime state and volumes created by docker compose
.data/
.volumes/
postgres-data/

# Run evidence: trails, frames, run folders, exports. Never committed.
/runs/
/.runs/
/evidence/
/exports/
*.dump
*.tar.zst

# Playwright and test output
test-results/
playwright-report/
blob-report/
.playwright/

# Generated code and bundles
**/generated/
.adminjs/
apps/control/.adminjs/

# Model caches baked into images, not the repo
.models/

# Rendered plan pages and private planning notes
plan/html/
plan/ASSESSMENT.md

# Editors and operating systems
.DS_Store
.idea/
*.swp

# Inputs to the plan (the brief and earlier drafts) are not published
plan/*.pdf

# Working notes and the generated project graph stay local
sessions/
docs/graph.json
docs/graph.template.html
docs/knowledge-graph.html

# Per-machine secrets and rendered env files
/secrets/
.run/
.sops.yaml
config/*.secrets.enc.env
# A second copy's moved ports (just fork-ports)
config/local.env
plan/REVIEW.md
