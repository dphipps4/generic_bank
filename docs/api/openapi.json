{
  "openapi": "3.1.0",
  "info": {
    "title": "Generic Bank Task API",
    "version": "1",
    "description": "Typed tasks at banks that have no API, done by operating each bank’s website the way a person would. No money moves without a person’s approval. Get a token with `just api-token`, press Authorize, and paste it."
  },
  "tags": [
    {
      "name": "tasks"
    },
    {
      "name": "catalog"
    },
    {
      "name": "oauth"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An OAuth2 access token from POST /oauth/token (or `just api-token`)."
      },
      "client": {
        "type": "oauth2",
        "description": "A client id and secret (the local one is in secrets/credentials.txt); Swagger UI gets the token.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "TaskResult": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "task": {
            "type": "string",
            "enum": [
              "check-balance",
              "transfer",
              "download-statements"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "business_outcome",
              "needs_human",
              "handed_off",
              "escalated",
              "failed",
              "expired",
              "cancelled"
            ]
          },
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "message": {
            "description": "A fixed, customer-safe sentence.",
            "type": "string"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "accountLabel": {
                    "type": "string",
                    "description": "The account as the bank names it, masked."
                  },
                  "availableCents": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "currentCents": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "asOf": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  }
                },
                "required": [
                  "accountLabel",
                  "availableCents",
                  "currentCents",
                  "asOf"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "confirmation": {
                    "type": "string"
                  },
                  "seenInHistory": {
                    "type": "boolean",
                    "description": "The transfer was read back from the account history."
                  }
                },
                "required": [
                  "confirmation",
                  "seenInHistory"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "months": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "month": {
                          "type": "string"
                        },
                        "statement": {
                          "description": "A stored statement reference, or null.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "month",
                        "statement"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "months"
                ],
                "additionalProperties": false
              }
            ]
          },
          "escalationId": {
            "description": "While escalated: the task in the Console inbox where a person resolves it.",
            "type": "string"
          },
          "resolvable": {
            "description": "While escalated: whether a person can let the run resume. After a guard trip it cannot.",
            "type": "boolean"
          },
          "pending": {
            "description": "While waiting on a person: what kind of answer is pending, and until when.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "staff_code",
                  "approval",
                  "supervisor_code"
                ]
              },
              "deadline": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "kind",
              "deadline"
            ],
            "additionalProperties": false
          },
          "resolvedBy": {
            "description": "Who finished the task by hand.",
            "type": "string"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "runId",
          "task",
          "status"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "escalationId": {
            "description": "A 409: the inbox task where a person resumes, finishes by hand or cancels.",
            "type": "string"
          },
          "resolvable": {
            "description": "A 409: whether the run can resume; false after a guard trip.",
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "retryable"
        ],
        "additionalProperties": false
      },
      "BankInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,30}$",
            "description": "The bank, by its id from GET /banks."
          },
          "brand": {
            "type": "string"
          },
          "productVersion": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string",
                  "enum": [
                    "check-balance",
                    "transfer",
                    "download-statements"
                  ]
                },
                "crawlerVersion": {
                  "type": "string"
                }
              },
              "required": [
                "task",
                "crawlerVersion"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "brand",
          "productVersion",
          "tasks"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/banks": {
      "get": {
        "operationId": "list_banks",
        "summary": "Lists every bank the system knows and the tasks each supports right now. Never contacts a bank.",
        "tags": [
          "catalog"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "responses": {
          "200": {
            "description": "The banks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BankInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "operationId": "list_tasks",
        "tags": [
          "catalog"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "summary": "The tasks and their input schemas.",
        "responses": {
          "200": {
            "description": "The catalog."
          }
        }
      }
    },
    "/tools": {
      "get": {
        "operationId": "list_tools",
        "tags": [
          "catalog"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "summary": "The API as tool definitions an agent loads directly. A tool call returns the endpoint’s answer, flagged as an error unless it is 200 (succeeded, handed_off) or 202 (waiting).",
        "responses": {
          "200": {
            "description": "The tools."
          }
        }
      }
    },
    "/tasks/check-balance": {
      "post": {
        "operationId": "check_balance",
        "summary": "Reads a member's available and current balance for one account, the way a member-services employee would. Never changes anything at the bank, and never shows a full account number.",
        "tags": [
          "tasks"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bank": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,30}$",
                    "description": "The bank, by its id from GET /banks."
                  },
                  "memberId": {
                    "type": "string",
                    "pattern": "^\\d{6,10}$",
                    "description": "The bank's member number, exactly as a member-services employee would type it."
                  },
                  "account": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40,
                    "description": "The account's last four digits, or its nickname as the bank shows it."
                  }
                },
                "required": [
                  "bank",
                  "memberId",
                  "account"
                ],
                "additionalProperties": false
              },
              "example": {
                "bank": "generic",
                "memberId": "40017732",
                "account": "Everyday Checking"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: running, or waiting on a person (`pending` names the kind of answer and its deadline). Location names the run.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResult"
                }
              }
            }
          },
          "400": {
            "description": "The input did not match the schema; the field that failed is named.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer access token is required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "insufficient_scope: the client lacks tasks:balance, or may not use this bank.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such bank, or no promoted crawler serves this task on it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests; see Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/transfer": {
      "post": {
        "operationId": "transfer",
        "summary": "Requests a transfer between a member's own accounts. Never moves money until a person approves it in the Console; until then the result is needs_human. To ask again, send the same idempotencyKey: it returns the same run, never a second transfer.",
        "tags": [
          "tasks"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bank": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,30}$",
                    "description": "The bank, by its id from GET /banks."
                  },
                  "memberId": {
                    "type": "string",
                    "pattern": "^\\d{6,10}$",
                    "description": "The bank's member number, exactly as a member-services employee would type it."
                  },
                  "from": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40,
                    "description": "The account's last four digits, or its nickname as the bank shows it."
                  },
                  "to": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40,
                    "description": "The account's last four digits, or its nickname as the bank shows it."
                  },
                  "amountCents": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 2500000,
                    "description": "The amount in cents."
                  },
                  "memo": {
                    "description": "What the member wants the transfer to say, up to 23 characters. The bank sees it after our own marker.",
                    "type": "string",
                    "maxLength": 23,
                    "pattern": "^[A-Za-z0-9 -]*$"
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 80,
                    "description": "The same key from the same client always returns the same run, so a retry never moves money twice."
                  }
                },
                "required": [
                  "bank",
                  "memberId",
                  "from",
                  "to",
                  "amountCents",
                  "idempotencyKey"
                ],
                "additionalProperties": false
              },
              "example": {
                "bank": "generic",
                "memberId": "40017732",
                "from": "Everyday Checking",
                "to": "Rainy Day Savings",
                "amountCents": 2500,
                "memo": "rent",
                "idempotencyKey": "try-transfer-0001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Asked again with the same key: succeeded or handed_off.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResult"
                }
              }
            }
          },
          "202": {
            "description": "Accepted: running, or waiting on a person (`pending` names the kind of answer and its deadline). Location names the run.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResult"
                }
              }
            }
          },
          "400": {
            "description": "The input did not match the schema; the field that failed is named.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer access token is required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "insufficient_scope: the client lacks tasks:transfer, or may not use this bank.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such bank, or no promoted crawler serves this task on it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "duplicate_transfer: the same member, accounts and amount are already in an open transfer, which runId and Location name. Or, asked again with the same key: escalated (unknown_screen, stuck, ambiguous_outcome, guard_tripped).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "410": {
            "description": "Asked again with the same key: expired or cancelled.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Asked again with the same key: business_outcome (no_such_member, member_closed, no_such_account, insufficient_funds, permission_denied, account_restricted, limit_exceeded, invalid_amount, approval_rejected).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests; see Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Asked again with the same key: failed, and a retry will not help.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Asked again with the same key: failed, and a retry may help; see Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/download-statements": {
      "post": {
        "operationId": "download_statements",
        "summary": "Fetches an account's monthly statements: one entry per month, either a reference for get_statement or the bank's own words for why it has none. Never changes anything at the bank.",
        "tags": [
          "tasks"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bank": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,30}$",
                    "description": "The bank, by its id from GET /banks."
                  },
                  "memberId": {
                    "type": "string",
                    "pattern": "^\\d{6,10}$",
                    "description": "The bank's member number, exactly as a member-services employee would type it."
                  },
                  "account": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40,
                    "description": "The account's last four digits, or its nickname as the bank shows it."
                  },
                  "months": {
                    "minItems": 1,
                    "maxItems": 24,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}$"
                    },
                    "description": "Months as YYYY-MM."
                  }
                },
                "required": [
                  "bank",
                  "memberId",
                  "account",
                  "months"
                ],
                "additionalProperties": false
              },
              "example": {
                "bank": "generic",
                "memberId": "40017732",
                "account": "Everyday Checking",
                "months": [
                  "2026-09"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted: running, or waiting on a person (`pending` names the kind of answer and its deadline). Location names the run.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResult"
                }
              }
            }
          },
          "400": {
            "description": "The input did not match the schema; the field that failed is named.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer access token is required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "insufficient_scope: the client lacks tasks:statements, or may not use this bank.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such bank, or no promoted crawler serves this task on it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests; see Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{runId}": {
      "get": {
        "operationId": "get_task",
        "summary": "Reads a task's current result by its runId, waiting up to `wait` seconds for it to settle. Never starts a task, and never repeats one.",
        "tags": [
          "tasks"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The runId a task call returned."
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Seconds to wait for the run to settle, up to 30.",
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "succeeded or handed_off.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResult"
                }
              }
            }
          },
          "202": {
            "description": "running or needs_human (awaiting_staff_code, awaiting_approval)."
          },
          "409": {
            "description": "escalated: unknown_screen, stuck, ambiguous_outcome, guard_tripped. escalationId names the task a person resolves in the Console; resolvable says whether the run can resume (not after a guard trip). Ask again: 202 after Resume, 200 handed_off after Finish by hand, 410 after Cancel.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "410": {
            "description": "expired or cancelled.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "business_outcome: no_such_member, member_closed, no_such_account, insufficient_funds, permission_denied, account_restricted, limit_exceeded, invalid_amount, approval_rejected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "failed, and a retry will not help.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "failed, and a retry may help; see Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/statements/{ref}": {
      "get": {
        "operationId": "get_statement",
        "summary": "Fetches a statement a download_statements run kept, by the reference in its result: the PDF exactly as the bank sent it. Needs tasks:statements. Never contacts the bank, and never returns a statement another client's run kept.",
        "tags": [
          "tasks"
        ],
        "security": [
          {
            "bearer": []
          },
          {
            "client": []
          }
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^st_([0-9a-f]{16})_(\\d{4}-(?:0[1-9]|1[0-2]))$",
              "description": "A statement reference from a download_statements result."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The statement.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer access token is required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The client may not use tasks:statements, or this bank.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No statement by that reference for this client: no_such_statement.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "operationId": "token",
        "tags": [
          "oauth"
        ],
        "summary": "Exchange a one-time code, or a refresh token, for tokens. Refresh tokens rotate; a spent one revokes its family.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "enum": [
                      "client_credentials",
                      "authorization_code",
                      "refresh_token"
                    ]
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "refresh_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "grant_type"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An access token (15 minutes) and a refresh token (30 days)."
          },
          "400": {
            "description": "invalid_grant"
          },
          "401": {
            "description": "invalid_client"
          }
        }
      }
    },
    "/oauth/revoke": {
      "post": {
        "operationId": "revoke",
        "tags": [
          "oauth"
        ],
        "summary": "Revoke a token and its whole family.",
        "responses": {
          "200": {
            "description": "Revoked, or never valid."
          }
        }
      }
    }
  }
}
