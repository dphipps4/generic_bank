// The control database (the data box). Memory has its own database and schema.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum Role {
  viewer
  /// No longer given: an admin approves (migration 0018).
  approver
  admin
}

enum TaskStatus {
  running
  succeeded
  business_outcome
  needs_human
  handed_off
  escalated
  failed
  expired
  cancelled
}

enum HumanTaskKind {
  staff_code
  approval
  supervisor_code
  escalation
}

enum HumanTaskStatus {
  open
  answered
  expired
  cancelled
}

enum DriverState {
  draft
  promoted
  demoted
  stuck
  retired
}

enum BundleKind {
  profile
  code
  table
}

enum EvalOutcome {
  passed
  failed
  could_not_run
}

model ConsoleUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(viewer)
  createdAt    DateTime @default(now())
}

model TaskRun {
  id              String       @id @default(cuid())
  task            String
  bank            String
  /// The API client that started the run.
  clientId        String?
  inputsMasked    Json
  /// The real inputs, sealed (AES-GCM) with a key only the API and the Runner hold.
  inputsSealed    String?
  /// Transfers carry one; the same key from the same client always returns the same run.
  idempotencyKey  String?
  /// A keyed hash of a transfer's bank, member, accounts and amount. Two open runs never share one:
  /// a partial unique index in migration 0006, which Prisma cannot express.
  dedupeKey       String?
  status          TaskStatus   @default(running)
  resultCode      String?
  retryable       Boolean?
  result          Json?
  driverVersionId String?
  startedAt       DateTime     @default(now())
  settledAt       DateTime?
  steps           Step[]
  frames          TrailFrame[]
  humanTasks      HumanTask[]

  @@unique([clientId, idempotencyKey])
  @@index([bank, task, startedAt])
}

model Step {
  id        String   @id @default(cuid())
  runId     String
  run       TaskRun  @relation(fields: [runId], references: [id])
  seq       Int
  name      String
  screen    String?
  action    String?
  outcome   String?
  startedAt DateTime @default(now())
  ms        Int?

  @@unique([runId, seq])
}

model TrailFrame {
  id             String   @id @default(cuid())
  runId          String
  run            TaskRun  @relation(fields: [runId], references: [id])
  seq            Int
  stepSeq        Int
  imageKey       String?
  withheldReason String?
  screenModelKey String?
  host           String
  path           String
  at             DateTime @default(now())

  @@unique([runId, seq])
}

model HumanTask {
  id            String          @id @default(cuid())
  runId         String
  run           TaskRun         @relation(fields: [runId], references: [id])
  kind          HumanTaskKind
  status        HumanTaskStatus @default(open)
  contextMasked Json
  /// A person's answer (a staff code), sealed, and cleared once the run has used it.
  answerSealed  String?
  /// What the person did (answer, approve, reject, take_over, resume, finish, cancel), and why.
  action        String?
  reason        String?
  /// Finish by hand: the result the person recorded, in the same shape as an automatic one.
  resolution    Json?
  /// An escalation after a guard trip cannot resume.
  resolvable    Boolean         @default(true)
  /// How many times the agent has asked about this task, and when it last did.
  asks          Int             @default(0)
  lastAskedAt   DateTime?
  openedAt      DateTime        @default(now())
  answeredAt    DateTime?
  answeredBy    String?
  deadline      DateTime
  grant         ApprovalGrant?

  @@index([status, deadline])
}

model ApprovalGrant {
  id          String    @id @default(cuid())
  humanTaskId String    @unique
  humanTask   HumanTask @relation(fields: [humanTaskId], references: [id])
  runId       String
  fromRef     String
  toRef       String
  amountCents Int
  memoToken   String
  nonce       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
}

model Driver {
  id                 String          @id @default(cuid())
  tenant             String
  task               String
  state              DriverState     @default(draft)
  activeVersionId    String?
  candidateVersionId String?
  previousVersionId  String?
  versions           DriverVersion[]
  events             RegistryEvent[]

  @@unique([tenant, task])
}

model DriverVersion {
  id                 String      @id @default(cuid())
  driverId           String
  driver             Driver      @relation(fields: [driverId], references: [id])
  version            Int
  sha256             String
  kind               BundleKind
  state              DriverState @default(draft)
  sourceFactoryRunId String?
  /// A learned crawler's table; none for a version that runs its bank's hand-written one.
  table              Json?
  createdAt          DateTime    @default(now())

  @@unique([driverId, version])
}

model RegistryEvent {
  id        String      @id @default(cuid())
  driverId  String
  driver    Driver      @relation(fields: [driverId], references: [id])
  fromState DriverState
  toState   DriverState
  by        String
  reason    String
  at        DateTime    @default(now())
}

model FactoryRun {
  id             String       @id @default(cuid())
  tenant         String
  task           String
  mode           String
  phase          String
  status         String
  spendUsd       Decimal      @default(0) @db.Decimal(10, 4)
  turns          Int          @default(0)
  stalls         Int          @default(0)
  startedAt      DateTime     @default(now())
  lastActivityAt DateTime     @default(now())
  /// A repair starts from this version's profile; an onboarding from the bank's base profile.
  baseVersionId  String?
  modelCalls     ModelCall[]
  evals          EvalResult[]
  recommendation Recommendation?
}

// The Supervisor's recommendation (plan, §7): the bank's profile drafted from the run's frames.
// Each claim cites frames of the run and is marked seen or guess; a person approves or rejects it,
// and a guess is approved only when the person ticks it.
model Recommendation {
  id           String     @id @default(cuid())
  factoryRunId String     @unique
  factoryRun   FactoryRun @relation(fields: [factoryRunId], references: [id])
  tenant       String
  claims       Json       @default("[]")
  /// The table the factory wrote, and its live check.
  table        Json?
  check        Json?
  status       String     @default("open")
  createdAt    DateTime   @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  reason       String?
}

model ModelCall {
  id            String     @id @default(cuid())
  factoryRunId  String
  factoryRun    FactoryRun @relation(fields: [factoryRunId], references: [id])
  role          String
  model         String
  // Set once prompts are reviewed files (§C.4).
  promptId      String?
  promptVersion Int?
  tokensIn      Int
  tokensOut     Int
  tokensCached  Int        @default(0)
  costUsd       Decimal    @db.Decimal(10, 4)
  at            DateTime   @default(now())
}

model EvalResult {
  id              String      @id @default(cuid())
  factoryRunId    String?
  factoryRun      FactoryRun? @relation(fields: [factoryRunId], references: [id])
  driverVersionId String?
  rung            String
  outcome         EvalOutcome
  details         Json
  at              DateTime    @default(now())
}

model RepairCase {
  id                  String    @id @default(cuid())
  tenant              String
  task                String
  status              String    @default("open")
  consecutiveFailures Int       @default(0)
  lastFailureAt       DateTime?
  lastSuccessAt       DateTime?
  /// The run that faulted, and the version that ran it. One case is open per tenant and task: a
  /// partial unique index in migration 0012.
  runId               String?
  versionId           String?
  openedAt            DateTime  @default(now())
}

model Freeze {
  id        String    @id @default(cuid())
  tenant    String
  layer     String
  runId     String?
  reason    String
  frozenAt  DateTime  @default(now())
  clearedAt DateTime?
  clearedBy String?
}

model SignInAttempt {
  id       String   @id @default(cuid())
  tenant   String
  operator String
  runId    String?
  outcome  String
  at       DateTime @default(now())

  @@index([tenant, operator, at])
}

model AuditEntry {
  id     String   @id @default(cuid())
  actor  String
  action String
  target String
  reason String
  at     DateTime @default(now())
}

// ── OAuth2 for the Task API ─────────────────────────────────────────────────
// Only keyed hashes of secrets, codes and tokens are stored: a copy of this database holds nothing
// anyone could use.

model ApiClient {
  id         String        @id @default(cuid())
  name       String
  clientId   String        @unique
  secretHash String
  scopes     String[]
  createdBy  String
  createdAt  DateTime      @default(now())
  revokedAt  DateTime?
  codes      ApiCode[]
  families   TokenFamily[]
}

/// The one-time starting code shown with a new client: 24 hours, single use.
model ApiCode {
  id        String    @id @default(cuid())
  clientPk  String
  client    ApiClient @relation(fields: [clientPk], references: [id])
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

/// Every token issued from one starting code, refresh after refresh. Reusing a spent refresh token
/// revokes the whole family.
model TokenFamily {
  id            String     @id @default(cuid())
  clientPk      String
  client        ApiClient  @relation(fields: [clientPk], references: [id])
  createdAt     DateTime   @default(now())
  revokedAt     DateTime?
  revokedReason String?
  tokens        ApiToken[]
}

enum TokenKind {
  access
  refresh
}

model ApiToken {
  id        String      @id @default(cuid())
  familyId  String
  family    TokenFamily @relation(fields: [familyId], references: [id])
  kind      TokenKind
  tokenHash String      @unique
  scopes    String[]
  expiresAt DateTime
  spentAt   DateTime?
  createdAt DateTime    @default(now())

  @@index([familyId])
}

// ── The banks the system knows ──────────────────────────────────────────────
// Which banks exist is the registry's answer: a bank is listed here, and a task is available on it
// when a promoted driver serves that task (Driver, by bank id).

model Bank {
  id             String   @id
  brand          String
  productVersion String
  /// Where the Runner reaches the bank's console.
  url            String
  /// The order banks are listed in.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
}

/// What the notifier told Slack about, once each: a person's task, a failed run, a route to review.
model SlackNotice {
  /// The id of what the notice is about: a HumanTask, TaskRun, FactoryRun or Recommendation.
  ref      String   @id
  kind     String
  channel  String
  /// Slack's id for the message, which is also its thread's.
  ts       String
  postedAt DateTime @default(now())
}
