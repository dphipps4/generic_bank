# Configuration that is not secret. Committed. Secrets live in the SOPS files beside it.
GB_IMAGE=generic-bank/node:dev
NODE_ENV=production

API_PORT=8000
CONSOLE_PORT=8080
RUNNER_PORT=8100
FACTORY_PORT=8200
MEMORY_PORT=8470

BANK_GENERIC_PORT=8081
BANK_EXAMPLE_PORT=8082
BANK_SAMPLE_PORT=8083
BANK_PLACEHOLDER_PORT=8084
BANK_INBOX_PORT=8089
# Ground truth for the test harness: each bank's admin API, published on this machine only.
BANK_GENERIC_ADMIN_PORT=9081
BANK_EXAMPLE_ADMIN_PORT=9082
BANK_SAMPLE_ADMIN_PORT=9083
BANK_PLACEHOLDER_ADMIN_PORT=9084

HAZARDS=default
HAZARD_SEED=20031014
# Forced hazards (a signed X-Hazards header) are for tests and evaluations; off for the live banks.
HAZARDS_FORCEABLE=false
RUNNER_CONCURRENCY=1

CONSOLE_ADMIN_EMAIL=admin@generic-bank.local

MODEL_OPERATOR=claude-opus-5-5
MODEL_SUPERVISOR=claude-sonnet-5-5
MODEL_SMALL=claude-haiku-4-5-20251001
