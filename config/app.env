# Configuration that is not secret. Committed. Secrets live in the SOPS files beside it.
GB_IMAGE=generic-bank/node:dev
# The Runner's image: the same, plus headless Chromium.
GB_RUNNER_IMAGE=generic-bank/runner:dev
NODE_ENV=production

API_PORT=8000
CONSOLE_PORT=8080
RUNNER_PORT=8100
FACTORY_PORT=8200
MEMORY_PORT=8470
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_DOCS_PORT=8099

BANK_GENERIC_PORT=8081
BANK_EXAMPLE_PORT=8082
BANK_SAMPLE_PORT=8083
BANK_PLACEHOLDER_PORT=8084
BANK_INBOX_PORT=8089
# A second origin: Bank 2's tab strip and Bank 4's sign-in form come from another port.
BANK_EXAMPLE_SECOND_PORT=8092
BANK_PLACEHOLDER_SECOND_PORT=8094
# Ground truth for the test harness: each bank's admin API, published on this machine only.
BANK_GENERIC_ADMIN_PORT=9081
BANK_EXAMPLE_ADMIN_PORT=9082
BANK_SAMPLE_ADMIN_PORT=9083
BANK_PLACEHOLDER_ADMIN_PORT=9084

HAZARDS=default
HAZARD_SEED=20031014
# What percentage of runs should hit a stopping hazard. Overrides the profile's scale when set.
HAZARD_RUN_RATE_PCT=3
# Forced hazards (a signed X-Hazards header) are for tests, evaluations and the hazard lab. On for
# this stack, whose banks are all ours; off wherever a bank is real.
HAZARDS_FORCEABLE=true
RUNNER_CONCURRENCY=2

# Each factory role's model: the Scout navigates (low effort), the Supervisor reasons (high).
# A provider is anthropic or openai; a model needs a price in apps/factory/src/models.ts.
FACTORY_SCOUT_PROVIDER=anthropic
FACTORY_SCOUT_MODEL=claude-sonnet-5-5
FACTORY_SCOUT_EFFORT=low
FACTORY_SUPERVISOR_PROVIDER=anthropic
FACTORY_SUPERVISOR_MODEL=claude-opus-5-5
FACTORY_SUPERVISOR_EFFORT=high

CONSOLE_ADMIN_EMAIL=admin@generic-bank.local

# The banks as the Runner and the factory reach them inside Docker, both origins where a bank has two.
# Chrome treats them as secure, as HTTPS would make them, so it sends what a real browser sends.
BANK_ORIGINS=http://bank-generic:8081,http://bank-example:8082,http://bank-example:8092,http://bank-sample:8083,http://bank-placeholder:8084,http://bank-placeholder:8094

# The staff usernames the Runner and the factory sign in with, the same at every bank: 8 characters
# or more. Their passwords are secrets, in SOPS.
BANK_OPERATOR_ID=teller0412
BANK_SUPERVISOR_ID=super0901
