{
  "name": "generic-bank",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/db/prisma/schema.prisma",
    "check": "npm run db:generate && npm run typecheck && npm run lint && npm run test && npm run depcruise"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.0",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
