{
  "_comment": "Which service receives which secret. Least privilege: a service gets only what it uses. The factory file goes only to the factory; a test enforces it. An entry NAME=SOURCE gives the service the secret SOURCE under the name NAME.",
  "derived": {
    "CONTROL_DATABASE_URL": "postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/control",
    "MEMORY_DATABASE_URL": "postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/memory",
    "BANK_DATABASE_URL_BASE": "postgresql://postgres:${BANK_DB_PASSWORD}@bank-db:5432"
  },
  "services": {
    "postgres": ["POSTGRES_PASSWORD"],
    "bank-db": ["POSTGRES_PASSWORD=BANK_DB_PASSWORD"],
    "minio": ["MINIO_ROOT_USER", "MINIO_ROOT_PASSWORD"],
    "migrate": ["CONTROL_DATABASE_URL"],
    "api": [
      "API_LOCAL_CLIENT_ID",
      "API_LOCAL_CLIENT_SECRET",
      "API_TOKEN_HASH_KEY",
      "CONTROL_DATABASE_URL",
      "RUN_SEAL_KEY",
      "MINIO_ROOT_USER",
      "MINIO_ROOT_PASSWORD"
    ],
    "console": [
      "CONTROL_DATABASE_URL",
      "CONSOLE_SESSION_SECRET",
      "CONSOLE_COOKIE_SECRET",
      "CONSOLE_ADMIN_PASSWORD",
      "MEMORY_TOKEN_CURATOR",
      "API_TOKEN_HASH_KEY",
      "MINIO_ROOT_USER",
      "MINIO_ROOT_PASSWORD",
      "ANSWER_SEAL_KEY"
    ],
    "runner": [
      "CONTROL_DATABASE_URL",
      "MINIO_ROOT_USER",
      "MINIO_ROOT_PASSWORD",
      "MEMORY_TOKEN_RUNNER",
      "MEMORY_SIGNING_KEY",
      "HAZARD_HMAC_KEY",
      "RUN_SEAL_KEY",
      "ANSWER_SEAL_KEY",
      "BANK_SERVICE_PASSWORD"
    ],
    "memory-migrate": ["MEMORY_DATABASE_URL"],
    "memory-seed": ["MEMORY_TOKEN_CURATOR", "MEMORY_SIGNING_KEY"],
    "memory": [
      "MEMORY_DATABASE_URL",
      "MEMORY_TOKEN_RUNNER",
      "MEMORY_TOKEN_FACTORY",
      "MEMORY_TOKEN_CURATOR",
      "MEMORY_TOKEN_SYSTEM",
      "MEMORY_SIGNING_KEY"
    ],
    "bank": [
      "BANK_DATABASE_URL_BASE",
      "HAZARD_HMAC_KEY",
      "BANK_ADMIN_TOKEN",
      "BANK_SERVICE_PASSWORD",
      "BANK_SUPERVISOR_PASSWORD"
    ],
    "bank-inbox": ["BANK_DATABASE_URL_BASE"],
    "factory": [
      "OPENROUTER_API_KEY",
      "CONTROL_DATABASE_URL",
      "MEMORY_TOKEN_FACTORY",
      "MEMORY_SIGNING_KEY",
      "FACTORY_GATEWAY_TOKEN",
      "HAZARD_HMAC_KEY",
      "MINIO_ROOT_USER",
      "MINIO_ROOT_PASSWORD",
      "BANK_SERVICE_PASSWORD",
      "ANSWER_SEAL_KEY",
      "BANK_ADMIN_TOKEN"
    ]
  }
}
