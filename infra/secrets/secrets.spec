# Every secret the system uses: FILE KEY HOW [-- what to enter]
#   HOW = hex       48 random hex characters, generated by just setup
#         password  20 random letters and digits (something a person types), generated
#         entered   issued by someone else, so a person enters it (just secret-set);
#                   just setup explains it and stops while it is blank
#         entered?  the same, but it may stay blank
# For an entered key, the text after -- is what just setup tells the person about it.
local   POSTGRES_PASSWORD        hex
local   BANK_DB_PASSWORD         hex
local   API_LOCAL_CLIENT_ID      hex
local   API_LOCAL_CLIENT_SECRET  hex
local   API_TOKEN_HASH_KEY       hex
local   RUN_SEAL_KEY             hex
local   ANSWER_SEAL_KEY          hex
local   CONSOLE_SESSION_SECRET   hex
local   CONSOLE_COOKIE_SECRET    hex
local   CONSOLE_ADMIN_PASSWORD   password
local   MINIO_ROOT_USER          hex
local   MINIO_ROOT_PASSWORD      hex
local   MEMORY_TOKEN_RUNNER      hex
local   MEMORY_TOKEN_CURATOR     hex
local   MEMORY_TOKEN_SYSTEM      hex
local   MEMORY_SIGNING_KEY       hex
local   HAZARD_HMAC_KEY          hex
local   BANK_ADMIN_TOKEN         hex
local   BANK_SERVICE_PASSWORD    password
local   BANK_SUPERVISOR_PASSWORD password
factory OPENROUTER_API_KEY       entered?  -- An OpenRouter API key, from openrouter.ai/settings/keys. The default provider; left blank, the factory runs in mock mode.
factory ANTHROPIC_API_KEY        entered?  -- A Claude API key, from console.anthropic.com under Settings, API keys. Only a factory role set to the anthropic provider uses it.
factory OPENAI_API_KEY           entered?  -- An OpenAI API key, from platform.openai.com under API keys. Only a factory role set to the openai provider uses it.
local   MEMORY_TOKEN_FACTORY     hex
factory FACTORY_GATEWAY_TOKEN    hex
