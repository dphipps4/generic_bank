# SOPS creation rules, written by `just setup` with YOUR age public key. Not committed:
# every clone has its own key and its own encrypted files.
#
#   config/local.secrets.enc.env    the app's secrets: databases, tokens, Console sign-in
#   config/factory.secrets.enc.env  FACTORY-ONLY: the model API key and the factory's tokens.
#                                   Only the factory receives it.
#
# Values are encrypted; keys stay readable, so a diff shows WHAT changed. Your private key
# lives in ~/.config/sops/age/keys.txt and never leaves this machine.
creation_rules:
  - path_regex: config/(local|factory)\.secrets\.enc\.env$
    age: __AGE_PUBLIC_KEY__
