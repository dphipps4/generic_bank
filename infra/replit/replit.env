# Read over config/app.env by service.sh. On Replit every service shares one machine, so the names
# compose gives them become localhost addresses, and its volumes become folders under .run.
ADMIN_JS_SKIP_BUNDLE=true
CHROME_PATH=/repl/tools/bin/chromium
# Chrome sends every *.localhost name to this machine, so the banks keep their own names.
BANK_ORIGINS=http://bank-generic.localhost:8081,http://bank-example.localhost:8082
API_URL=http://localhost:8000
MEMORY_URL=http://localhost:8470
FACTORY_URL=http://localhost:8200
EVIDENCE_DIR=$PWD/.run/data/evidence
SESSIONS_DIR=$PWD/.run/data/sessions
MEMORY_MODEL_DIR=$PWD/.run/models
